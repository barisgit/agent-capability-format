[0.001, "o", "\r\n"]
[0.000, "o", "settings.json after remove  (still has user_key + permissions):\r\n"]
[3.006, "o", "\r\n\u001b[1;36m==> Demo complete. Cleaning up /var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm\u001b[0m\r\n"]
