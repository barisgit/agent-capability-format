{"version":3,"term":{"cols":80,"rows":24},"timestamp":1779988184,"command":"bash scripts/demo-caplet.sh","title":"caplet end-to-end demo: fetch / apply / sidecar / idempotent / remove","env":{"SHELL":"/opt/homebrew/bin/fish"}}
[0.019, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "================================================================\r\n caplet demo: build a capability, fetch, apply, inspect sidecar,\r\n demonstrate idempotence + user-key preservation, remove.\r\n================================================================\r\n"]
[1.008, "o", "\r\n\u001b[1;36m==> 1. Build a tiny local ACF capability  (/var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/sources/code-review)\u001b[0m\r\n"]
[0.626, "o", "code-review/instructions/style.md\r\ncode-review/agents/reviewer.md\r\ncode-review/mcp/mcp.yml\r\ncode-review/acf.yml\r\ncode-review/skills/review-pr/SKILL.md\r\n"]
[2.005, "o", "\r\n\u001b[1;36m==> 2. Wire it into the project via capabilities.yml\u001b[0m\r\n"]
[0.622, "o", "acf: 1\r\ncapabilities:\r\n  - source: path:/var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/sources/code-review\r\n"]
[2.007, "o", "\r\n\u001b[1;36m==> 3. caplet doctor  (environment check)\u001b[0m\r\n"]
[0.855, "o", "pass git available                                                  \u001b[90m7:09:51 PM\u001b[39m\r\n"]
[0.001, "o", "\u001b[90m[\u001b[90m7:09:51 PM\u001b[90m]\u001b[39m pass readable /var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/home/.agents\r\n"]
[0.000, "o", "pass target claude                                                  \u001b[90m7:09:51 PM\u001b[39m\r\n"]
[0.000, "o", "pass target codex                                                   \u001b[90m7:09:51 PM\u001b[39m\r\n"]
[0.000, "o", "pass target cursor                                                  \u001b[90m7:09:51 PM\u001b[39m\r\n"]
[0.000, "o", "pass target opencode                                                \u001b[90m7:09:51 PM\u001b[39m\r\n"]
[0.000, "o", "pass target pi                                                      \u001b[90m7:09:51 PM\u001b[39m\r\n"]
[0.000, "o", "pass lockfile user                                                  \u001b[90m7:09:51 PM\u001b[39m\r\n"]
[0.000, "o", "pass lockfile project                                               \u001b[90m7:09:51 PM\u001b[39m\r\n"]
[2.010, "o", "\r\n\u001b[1;36m==> 4. caplet fetch  (resolve path: source -> capability tree + lockfile)\u001b[0m\r\n"]
[0.747, "o", "fetched 1 capabilities across 1 scopes                              \u001b[90m7:09:54 PM\u001b[39m\r\n"]
[0.003, "o", "\r\n"]
[0.000, "o", "Capability tree under /var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/project/.agents/capabilities/:\r\n"]
[0.004, "o", ".agents/capabilities/code-review/instructions/style.md\r\n.agents/capabilities/code-review/agents/reviewer.md\r\n.agents/capabilities/code-review/mcp/mcp.yml\r\n.agents/capabilities/code-review/acf.yml\r\n.agents/capabilities/code-review/skills/review-pr/SKILL.md\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "Lockfile head:\r\n"]
[0.002, "o", "{\r\n  \"acf\": 1,\r\n  \"entries\": [\r\n    {\r\n      \"capabilityHash\": \"sha256-a36d4de798db97490373200d0ea1a3729ea8265bd58e4d3a8a5752990eecd132\",\r\n      \"capabilityNames\": [\r\n        \"code-review\"\r\n      ],\r\n      \"resolvedAt\": \"2026-05-28T17:09:54.438Z\",\r\n      \"source\": \"path:/var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/sources/code-review\",\r\n      \"sourceId\": \"path:/var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/sources/code-review\"\r\n    }\r\n  ]\r\n}\r\n"]
[3.008, "o", "\r\n\u001b[1;36m==> 5. Pre-seed user-authored key inside ~/.claude/settings.json\u001b[0m\r\n"]
[0.626, "o", "{\r\n  \"user_key\": \"this must survive caplet apply + remove\",\r\n  \"permissions\": { \"allow\": [\"Bash(*)\", \"Read(*)\"] }\r\n}\r\n"]
[2.005, "o", "\r\n\u001b[1;36m==> 6. caplet apply  (emit FileDiffs, write artifacts + sidecar)\u001b[0m\r\n"]
[0.734, "o", "\u001b[90m[\u001b[90m7:10:00 PM\u001b[90m]\u001b[39m create .agents/skills/review-pr/SKILL.md (project:claude:code-review)\r\n"]
[0.000, "o", "\u001b[90m[\u001b[90m7:10:00 PM\u001b[90m]\u001b[39m create /var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/project/.claude/agents/reviewer.md (project:claude:code-review)\r\n"]
[0.000, "o", "\u001b[90m[\u001b[90m7:10:00 PM\u001b[90m]\u001b[39m create /var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/project/.claude/CLAUDE.md (project:claude:code-review)\r\n"]
[0.000, "o", "\u001b[90m[\u001b[90m7:10:00 PM\u001b[90m]\u001b[39m create /var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/project/.mcp.json (project:claude:code-review)\r\n"]
[0.004, "o", "applied 4 writes and 0 deletes                                      \u001b[90m7:10:00 PM\u001b[39m\r\n"]
[1.004, "o", "\r\nProject install root (./.claude/) now contains:\r\n"]
[0.006, "o", ".claude/agents/reviewer.md\r\n.claude/.acf-managed.json\r\n"]
[0.000, "o", ".claude/CLAUDE.md\r\n"]
[3.007, "o", "\r\n\u001b[1;36m==> 7. .acf-managed.json sidecar  (every owned region recorded)\u001b[0m\r\n"]
[0.613, "o", "{\r\n  \"acf\": 1,\r\n  \"managed\": [\r\n    {\r\n      \"path\": \"../../../../../../../../private/var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/project/.agents/skills/review-pr/SKILL.md\",\r\n      \"owns\": [\r\n        {\r\n          \"kind\": \"file\"\r\n        }\r\n      ],\r\n      \"capability\": \"code-review\",\r\n      \"hash\": \"sha256-48a2e0acf16f35672944761086e2947ac2c61e8bbd5cfb3670676ee9e27f2753\"\r\n    },\r\n    {\r\n      \"path\": \"../.mcp.json\",\r\n      \"owns\": [\r\n        {\r\n          \"kind\": \"json-pointer\",\r\n          \"pointer\": \"/mcpServers/code-review-tools\"\r\n        }\r\n      ],\r\n      \"capability\": \"code-review\",\r\n      \"hash\": \"sha256-136a9b17afaf6ef6ec0176dbf2fb9fbf75230616190925cac75bf204f91b5082\"\r\n    },\r\n    {\r\n      \"path\": \"agents/reviewer.md\",\r\n      \"owns\": [\r\n        {\r\n          \"kind\": \"file\"\r\n        }\r\n      ],\r\n"]
[0.000, "o", "      \"capability\": \"code-review\",\r\n      \"hash\": \"sha256-3b37f87d04fc165c48b0c0e7524f19d325d7760796dee6c9951a1da0b1f795aa\"\r\n    },\r\n    {\r\n      \"path\": \"CLAUDE.md\",\r\n      \"owns\": [\r\n        {\r\n          \"kind\": \"marker\",\r\n          \"name\": \"code-review.style\"\r\n"]
[3.008, "o", "\r\n\u001b[1;36m==> 8. Marker block inside CLAUDE.md  (instruction activation: always)\u001b[0m\r\n"]
[0.614, "o", "<!-- acf:begin code-review.style -->\r\nAlways check naming clarity and test coverage when reviewing.\r\n<!-- acf:end code-review.style -->\r\n"]
[3.009, "o", "\r\n\u001b[1;36m==> 9. settings.json after apply  (user_key + permissions PRESERVED)\u001b[0m\r\n"]
[3.619, "o", "\r\n\u001b[1;36m==> 10. caplet diff  (re-emit: idempotent -> no pending diffs)\u001b[0m\r\n"]
[0.873, "o", "0 pending diffs                                                     \u001b[90m7:10:16 PM\u001b[39m\r\n"]
[2.009, "o", "\r\n\u001b[1;36m==> 11. caplet ls  (resolved capabilities per scope)\u001b[0m\r\n"]
[0.716, "o", "\u001b[90m[\u001b[90m7:10:19 PM\u001b[90m]\u001b[39m project:/var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/project/.agents\r\n"]
[0.001, "o", "  code-review@1.0.0 skills=1 agents=1 instructions=1 mcp=1          \u001b[90m7:10:19 PM\u001b[39m\r\n"]
[2.006, "o", "\r\n\u001b[1;36m==> 12. caplet inspect code-review\u001b[0m\r\n"]
[0.738, "o", "{\r\n  \"name\": \"code-review\",\r\n  \"version\": \"1.0.0\",\r\n  \"scope\": \"project\",\r\n  \"root\": \"/var/folders/jy/098pldf54rj47nxsdhy7p1100000gn/T/caplet-demo-XXXX.eIljspMmCm/project/.agents/capabilities/code-review\",\r\n  \"facets\": {\r\n    \"skills\": [\r\n      \"review-pr\"\r\n    ],\r\n    \"agents\": [\r\n      \"reviewer\"\r\n    ],\r\n    \"commands\": [],\r\n    \"instructions\": [\r\n      \"style\"\r\n    ],\r\n    \"hooks\": [],\r\n    \"mcp\": [\r\n      \"code-review-tools\"\r\n    ]\r\n  },\r\n  \"applicability\": {\r\n    \"claude\": true,\r\n    \"codex\": true,\r\n    \"cursor\": true,\r\n    \"opencode\": true,\r\n    \"pi\": true\r\n  },\r\n  \"diagnostics\": []\r\n}\r\n"]
[3.012, "o", "\r\n\u001b[1;36m==> 13. caplet remove code-review  (clean only ACF-owned regions)\u001b[0m\r\n"]
[0.723, "o", "removed code-review; cleaned 4 managed regions                      \u001b[90m7:10:25 PM\u001b[39m\r\n"]
[1.006, "o", "\r\nProject .claude/ tree after remove (user files intact):\r\n"]
