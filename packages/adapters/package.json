{
  "name": "@caplet/adapters",
  "version": "0.1.0",
  "description": "Target adapters that emit Agent Capability Format capabilities into Claude Code, Codex, Cursor, OpenCode, and Pi.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barisgit/agent-capability-format.git",
    "directory": "packages/adapters"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "default": "./dist/claude/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "default": "./dist/codex/index.js"
    },
    "./cursor": {
      "types": "./dist/cursor/index.d.ts",
      "default": "./dist/cursor/index.js"
    },
    "./opencode": {
      "types": "./dist/opencode/index.d.ts",
      "default": "./dist/opencode/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "default": "./dist/pi/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE LICENSE",
    "check-types": "tsgo --noEmit -p tsconfig.json",
    "lint": "echo 'no lint for @caplet/adapters'",
    "test": "bun test"
  },
  "dependencies": {
    "@caplet/core": "workspace:*",
    "@caplet/runtime-taxonomy": "workspace:*",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20251104.1",
    "typescript": "5.9.3"
  }
}
