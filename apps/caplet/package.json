{
  "name": "@caplet/cli",
  "version": "0.1.0",
  "description": "caplet: install agent capabilities and sync them into your AI tools.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barisgit/agent-capability-format.git",
    "directory": "apps/caplet"
  },
  "type": "module",
  "bin": {
    "caplet": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "prepack": "cp ../../LICENSE LICENSE",
    "check-types": "tsgo --noEmit -p tsconfig.json",
    "lint": "echo 'no lint for caplet'",
    "test": "bun test",
    "start": "bun src/bin.ts",
    "caplet": "bun src/bin.ts",
    "link": "bun run build && bun link"
  },
  "dependencies": {
    "@caplet/adapters": "workspace:*",
    "@caplet/core": "workspace:*",
    "@caplet/installer": "workspace:*",
    "@caplet/sdk": "workspace:*",
    "citty": "0.1.6",
    "consola": "3.4.0"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20251104.1",
    "typescript": "5.9.3"
  }
}
